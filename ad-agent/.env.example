# Copy to .env (run.py setup does it for you). The app runs and demos fully with none of these set.

# LLM: gemini | ollama | cache-only. Order tried: cache -> Gemini -> Ollama -> built-in templates.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Check https://aistudio.google.com for which Flash / Flash-Lite model the free tier offers today.
GEMINI_MODEL=gemini-2.5-flash-lite
# Local "private mode". 8 GB laptops: qwen3:1.7b. 16 GB: qwen3:4b.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
LLM_TIMEOUT_S=15

# Budget proposals are posted here with approve/reject links.
DISCORD_WEBHOOK_URL=
# Where those links point. For a phone on the same Wi-Fi: http://<laptop LAN IP>:8000 and
# start with `python run.py demo --host 0.0.0.0` (accept the Windows Firewall prompt).
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Simulator
SEED=7
HISTORY_DAYS=30
TICK_SECONDS=4
TWIN_SCALE=50

# Embeddings: auto (fastembed MiniLM, falls back to hashing if it cannot download) | hash
EMBEDDER=auto
